# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill it in. `npm run dev` reads
# `.env.local`; nothing else does.
#
# The assistant is DeepSeek-only. There is no second model provider and no
# hosted vector database: the embeddings and the reranker are ONNX models
# that run on the server, and the index lives in Postgres on Neon. Rate
# limiting is IN-PROCESS and PER-INSTANCE (it is a map in the memory of one
# serverless instance), so it is a guard against a single noisy client, not
# a global quota. The global quota is the daily spend ceiling below.
# ---------------------------------------------------------------------------

# --- The model ------------------------------------------------------------

# DeepSeek API key. Required for the live assistant.
# The key is server-only: never prefix it with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=

# The maximum the assistant may spend on the model per day, in USD.
# At the ceiling the assistant answers from the content layer instead of
# calling the model, and the answer says so.
DAILY_SPEND_CEILING_USD=2.00

# --- The database ---------------------------------------------------------

# The POOLED Neon connection string. This is the one the app uses for
# everything except the vector search: queries, the answer log, the index.
DATABASE_URL=

# The DIRECT (unpooled) Neon connection string. REQUIRED for the ANN leg.
#
# The pooler sits between the app and Postgres and cannot serve the
# `lakebase_ann` extension that the vector index is built on, so the ANN
# search has to go over a direct connection. `lib/retrieval/db.ts` reads
# this variable for the vector leg and fails loudly when it is missing.
DATABASE_URL_UNPOOLED=

# --- The indexer ----------------------------------------------------------

# Where the six source repositories live on disk, for `npm run index`.
# Defaults to ~/Desktop/GitHub projects, which is where they live on the
# author's machine. Set it on CI or on any other machine.
KAUSTUBH_REPOS_ROOT=

# --- The MCP endpoint -----------------------------------------------------

# Bearer token for POST /mcp.
#
# REQUIRED IN PRODUCTION. When this variable is unset, /mcp serves the
# line-exact source of every indexed repository to anyone who asks, and it
# logs an error on every request. When it is set, clients must send
#   Authorization: Bearer <MCP_AUTH_TOKEN>
MCP_AUTH_TOKEN=

# --- The site -------------------------------------------------------------

# The public origin of the deployment.
#
# A missing value falls back to http://localhost:3000, and that fallback is
# BAKED INTO THE BUILD: every canonical URL, every Open Graph tag and every
# sitemap entry would point at localhost. Set it in production to
# https://kaustubh-portfolio-navy.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
