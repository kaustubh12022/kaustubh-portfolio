# DeepSeek — primary model provider
DEEPSEEK_API_KEY=

# Google Gemini — fallback chat, routing, and embeddings
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase — server-only. Never expose the service role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Upstash rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Spend guard - the maximum the assistant may spend on the LLM per day.
# At the ceiling the assistant answers from the content layer instead of the model.
DAILY_SPEND_CEILING_USD=2.00
