{
  "name": "kaustubh-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "eval": "promptfoo eval -c evals/promptfoo.yaml --delay 250 --max-concurrency 4",
    "eval:answers": "tsx scripts/eval/golden-eval.ts",
    "eval:cases": "tsx scripts/eval/gen-promptfoo-cases.ts",
    "eval:retrieval": "tsx --conditions=react-server scripts/eval/retrieval-eval.ts",
    "bench": "tsx --conditions=react-server scripts/eval/bench.ts",
    "index": "tsx scripts/index/index.ts",
    "index:dry": "tsx scripts/index/index.ts --dry-run"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.67",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "ai": "7.0.143",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "onnxruntime-common": "1.30.0",
    "onnxruntime-node": "1.30.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.4.2",
    "promptfoo": "^0.124.1",
    "tailwindcss": "^4.3.3",
    "tree-sitter-wasms": "^0.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "web-tree-sitter": "^0.25.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
